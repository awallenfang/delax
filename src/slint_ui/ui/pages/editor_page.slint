import {
    Slider,
    VerticalBox,
    AboutSlint,
    CheckBox,
    Switch, Spinner, HorizontalBox
} from "std-widgets.slint";
import { ParamKnob } from "../components/param_knob.slint";
import { ParamBus } from "../events.slint";
import { ParamSwitch } from "../components/param_switch.slint";
import { Palette, UIJump, UIJumpSegment } from "../global.slint";
import { PeakMeter } from "../components/peak_meter.slint";
import { SpectrumAnalyzer } from "../components/spectrum_analyzer.slint";
import { Button } from "../components/button.slint";
import { EditorBufferVisualizer } from "../components/editor_buffer_vis.slint";
import { IconButton } from "../components/icon_button.slint";

export component EditorPage inherits VerticalLayout {
    in property <image> editor_tex_l;
    in property <image> editor_tex_r;
    in-out property <float> read_head_l;
    in-out property <float> read_head_r;
    in-out property <float> write_head_l;
    in-out property <float> write_head_r;
    in-out property <bool> is_stereo;
    in-out property <bool> is_ping_pong;
    in property <[UIJump]> read_jumps_l;
    in property <[UIJump]> read_jumps_r;
    in property <[UIJump]> write_jumps_l;
    in property <[UIJump]> write_jumps_r;
    in property <[UIJumpSegment]> read_segments_l;
    in property <[UIJumpSegment]> read_segments_r;
    in property <[UIJumpSegment]> write_segments_l;
    in property <[UIJumpSegment]> write_segments_r;
    callback segment-swapped(int, int, int);

    VerticalLayout {
        vertical-stretch: 1;
        spacing: 4px;
        EditorBufferVisualizer {
            horizontal-stretch: 1;
            texture: root.editor_tex_l;
            read_head <=> root.read_head_l;
            write_head <=> root.write_head_l;
            read_jumps: root.read_jumps_l;
            write_jumps: root.write_jumps_l;
            read_segments: root.read_segments_l;
            write_segments: root.write_segments_l;
            segment-swapped(a, b) => { root.segment-swapped(0, a, b); }
        }
        EditorBufferVisualizer {
            horizontal-stretch: 1;
            texture: root.editor_tex_r;
            read_head <=> root.read_head_r;
            write_head <=> root.write_head_r;
            left_channel: true;
            read_jumps: root.read_jumps_r;
            write_jumps: root.write_jumps_r;
            read_segments: root.read_segments_r;
            write_segments: root.write_segments_r;
            segment-swapped(a, b) => { root.segment-swapped(1, a, b); }
        }
    }
    Text {
        text: "Press segment to swap";
        color: Palette.text;
    }
    HorizontalLayout {
        height: 25px;
        width: 10%;
        alignment: LayoutAlignment.center;
        spacing: 10px;
        IconButton {
            width: 25px;
            height: 25px;
            checked: !root.is_stereo;
            Image {
                source: @image-url("../assets/mono.svg");
                image-fit: contain;
                colorize: parent.checked ? Palette.text-dark : Palette.text;
            }

            clicked => {
                ParamBus.param_changed("stereo", 0.0);
            }
        }
        IconButton {
            width: 25px;
            height: 25px;
            checked: root.is_stereo && !is_ping_pong;
            Image {
                source: @image-url("../assets/stereo.svg");
                image-fit: contain;
                colorize: parent.checked ? Palette.text-dark : Palette.text;
            }

            clicked => {
                ParamBus.param_changed("stereo", 0.5);
            }
        }
        IconButton {
            width: 25px;
            height: 25px;
            checked: root.is_ping_pong;
            Image {
                source: @image-url("../assets/pingpong.svg");
                image-fit: contain;
                colorize: parent.checked ? Palette.text-dark : Palette.text;
            }

            clicked => {
                ParamBus.param_changed("stereo", 1.0);
            }
        }
    }
    HorizontalLayout {
        ParamKnob {
            param_name: "buffer_len_l";
            label: "Buffer L";
            val: ParamBus.read_val("buffer_len_l");
        }
        if is_stereo:
        ParamKnob {
            param_name: "buffer_len_r";
            label: "Buffer R";
            val: ParamBus.read_val("buffer_len_r");
        }
    }
}