import { VerticalBox, Slider } from "std-widgets.slint";
import { ParamBus, DragApi } from "../events.slint";
import { Palette, UIJump, UIJumpSegment, UIPortal } from "../global.slint";
import { IconButton } from "icon_button.slint";

export component EditorBufferVisualizer inherits Rectangle {
    in-out property <image> texture;
    in-out property <float> read_head;
    in-out property <float> write_head;
    in property <bool> left_channel;
    in property <[UIJump]> read_jumps;
    in property <[UIJump]> write_jumps;
    in property <[UIJumpSegment]> read_segments;
    in property <[UIJumpSegment]> write_segments;
    in property <[UIPortal]> read_portals;

    callback segment-swapped(int, int);
    callback segment-boundary-moved(int, float);
    callback portal-unglued(int);
    callback portal-reweld(int);
    callback portal-exit-moved(int, float);
    callback portal-entry-moved(int, float);
    callback segment-split(int);
    callback segments-merged(int);

    private property <int> selected: -1;
    private property <int> drag-over-idx: -1;
    private property <bool> is-dragging: false;
    VerticalLayout {
        if !left_channel:
        Rectangle {
            height: 13px;
            Text {
                x: max(0, min(write_head * root.width - self.width / 2, root.width - self.width));
                y: 0;
                font-size: 13px;
                text: "W";
                color: Palette.text;
                height: parent.height;
                horizontal-alignment: center;
            }
            Text {
                x: max(0, min(read_head * root.width - self.width / 2, root.width - self.width));
                y: 0;
                font-size: 13px;
                text: "R";
                color: Palette.text;
                height: parent.height;
                horizontal-alignment: center;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            Image {
                source:  root.texture;
                width: 100%;
                height: parent.height;
            }
            Rectangle {
                x: read_head * root.width;
                height: parent.height;
                width: 1px;
                background: Palette.primary;
                clip: false;
            }
            Rectangle {
                x: write_head * root.width;
                height: parent.height;
                width: 1px;
                background: Palette.secondary;
                clip: false;
            }
            for segment[idx] in read_segments:
            drop-zone := DropArea {
                x: segment.start * root.width;
                height: parent.height;
                y: 0;
                width: (segment.end - segment.start) * root.width;
                
                can-drop(event) => {
                    root.drag-over-idx = idx;
                    return DragAction.move;
                }

                dropped(event) => {
                    let payload = DragApi.transfer-to-string(event.data);
                    if (payload != "") {
                        let source-idx = payload.to-float().floor();
                        if (source-idx != idx) {
                            root.segment-swapped(source-idx, idx);
                        }
                    }
                    root.drag-over-idx = -1;
                    root.is-dragging = false;
                    return DragAction.move;
                }
                Rectangle {
                    x: 0; 
                    height: parent.height / 2;
                    y: 0;
                    width: parent.width;
                    background: root.drag-over-idx == idx ? Palette.secondary.transparentize(0.5) 
                        : @linear-gradient(90deg, Palette.primary.transparentize(0.8) 0%, #00000000 50%, Palette.primary.transparentize(0.8) 100%);
                    
                    clip: false;

                    border-width: (root.selected == idx || root.drag-over-idx == idx) ? 2px : 0px;
                    border-color: root.drag-over-idx == idx ? Palette.secondary : Palette.primary;

                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }
                    drag-area := DragArea {
                        width: 100%;
                        height: 100%;
                        data: DragApi.string-to-transfer(idx.to-string-unlocalized());
                        allow-move: true;
                        enabled: !root.is-dragging || drag-area.dragging;

                        drag-finished(action) => {
                            root.is-dragging = false;
                            root.drag-over-idx = -1;
                        }
                        changed dragging => {
                            if (self.dragging) {
                                root.is-dragging = true;
                            }
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            Text {                   
                                x: drag-area.width / 2 - self.width / 2;
                                y: drag-area.height / 2 - self.height / 2;
                                text: segment.order + 1;
                                color: Palette.text-muted;
                            }
                        }
                    }
                    split-ta := TouchArea {
                        width: 40px;
                        height: 20px;
                        x: (parent.width / 2) - (self.width / 2);
                        y: parent.height - self.height;
                        mouse-cursor: pointer;
                        enabled: !root.is-dragging;
                        Rectangle {
                            width: 100%;
                            height: 100%;
                        }
                    }
                    
                    split-btn := IconButton {
                        visible: split-ta.has-hover || split-btn.hovered;
                        width: 20px;
                        height: 20px;
                        enabled: true;
                        x: (parent.width / 2) - (self.width / 2);
                        y: parent.height - (self.height / 2);
                        Image {
                            source: @image-url("../assets/split.svg");
                            image-fit: contain;
                        }
                        clicked => {
                            root.segment-split(idx)
                        }
                    }
                    merge-ta := TouchArea {
                        x: - self.width / 2;
                        height: parent.height;
                        width: 20px;
                        enabled: !root.is-dragging;
                        Rectangle {
                            width: 100%;
                            height: 100%;
                        }
                    }
                    merge-btn := IconButton {
                        visible: idx > 0 && (merge-ta.has-hover || merge-btn.hovered);
                        width: 20px;
                        height: 20px;
                        enabled: true;
                        x: - self.width / 2;
                        y: (parent.height / 2) - (self.height / 2);
                        Image {
                            source: @image-url("../assets/merge.svg");
                            image-fit: contain;
                        }

                        clicked => {
                            root.segments-merged(idx)
                        }
                    }
                }
            }
            for segment in write_segments:
            Rectangle {
                x: segment.start * root.width;
                height: parent.height / 2;
                y: parent.height / 2;
                width: (segment.end - segment.start) * root.width;
                background: @linear-gradient(90deg, Palette.secondary 0%, #00000000 50%, Palette.secondary 100%);
                opacity: 0.2;
                clip: false;
                Text {
                    x: parent.width / 2;
                    y: parent.height / 2;
                    text: segment.order + 1;
                    color: Palette.text-muted;
                }
            }

        }
        if left_channel:
        Rectangle {
            height: 10px;
            Text {
                x: max(0, min(write_head * root.width - self.width / 2, root.width - self.width));
                y: 0;
                font-size: 10px;
                text: "W";
                color: Palette.text;
                height: parent.height;
                horizontal-alignment: center;
            }
            Text {
                x: max(0, min(read_head * root.width - self.width / 2, root.width - self.width));
                y: 0;
                font-size: 10px;
                text: "R";
                color: Palette.text;
                height: parent.height;
                horizontal-alignment: center;
            }
        }
    }
}