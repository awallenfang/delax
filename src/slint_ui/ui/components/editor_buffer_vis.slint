import { VerticalBox, Slider } from "std-widgets.slint";
import { ParamBus } from "../events.slint";
import { Palette, UIJump, UIJumpSegment } from "../global.slint";

export component EditorBufferVisualizer inherits Rectangle {
    in-out property <image> texture;
    in-out property <float> read_head;
    in-out property <float> write_head;
    in property <bool> left_channel;
    in property <[UIJump]> read_jumps;
    in property <[UIJump]> write_jumps;
    in property <[UIJumpSegment]> read_segments;
    in property <[UIJumpSegment]> write_segments;
    callback segment-swapped(int, int);
    private property <int> selected: -1;
    VerticalLayout {
        if !left_channel:
        Rectangle {
            height: 13px;
            Text {
                x: max(0, min(write_head * root.width - self.width / 2, root.width - self.width));
                y: 0;
                font-size: 13px;
                text: "W";
                color: Palette.text;
                height: parent.height;
                horizontal-alignment: center;
            }
            Text {
                x: max(0, min(read_head * root.width - self.width / 2, root.width - self.width));
                y: 0;
                font-size: 13px;
                text: "R";
                color: Palette.text;
                height: parent.height;
                horizontal-alignment: center;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            Image {
                source:  root.texture;
                width: 100%;
                height: parent.height;
            }
            Rectangle {
                x: read_head * root.width;
                height: parent.height;
                width: 1px;
                background: Palette.primary;
                clip: false;
            }
            Rectangle {
                x: write_head * root.width;
                height: parent.height;
                width: 1px;
                background: Palette.secondary;
                clip: false;
            }
            for segment[idx] in read_segments:
            Rectangle {
                x: segment.start * root.width;
                height: parent.height / 2;
                y: 0;
                width: (segment.end - segment.start) * root.width;
                background: @linear-gradient(90deg, Palette.primary 0%, #00000000 50%, Palette.primary 100%);
                opacity: 0.2;
                clip: false;
                border-width: root.selected == idx ? 2px : 0px;
                border-color: Palette.primary;
                Text {                   
                    x: parent.width / 2;
                    y: parent.height / 2;
                    text: segment.order;
                    color: Palette.text-muted;
                }
                TouchArea {
                    clicked => {
                        if (root.selected == -1) {
                            root.selected = idx;
                        } else {
                            if (root.selected != idx) {
                                root.segment-swapped(root.selected, idx);
                            }
                            root.selected = -1;
                        }
                    }
                }
            }
            for segment in write_segments:
            Rectangle {
                x: segment.start * root.width;
                height: parent.height / 2;
                y: parent.height / 2;
                width: (segment.end - segment.start) * root.width;
                background: @linear-gradient(90deg, Palette.secondary 0%, #00000000 50%, Palette.secondary 100%);
                opacity: 0.2;
                clip: false;
                Text {
                    x: parent.width / 2;
                    y: parent.height / 2;
                    text: segment.order;
                    color: Palette.text-muted;
                }
            }

        }
        if left_channel:
        Rectangle {
            height: 10px;
            Text {
                x: max(0, min(write_head * root.width - self.width / 2, root.width - self.width));
                y: 0;
                font-size: 10px;
                text: "W";
                color: Palette.text;
                height: parent.height;
                horizontal-alignment: center;
            }
            Text {
                x: max(0, min(read_head * root.width - self.width / 2, root.width - self.width));
                y: 0;
                font-size: 10px;
                text: "R";
                color: Palette.text;
                height: parent.height;
                horizontal-alignment: center;
            }
        }
    }
}