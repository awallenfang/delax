export global Palette {
    in-out property <color> text: #fffffa;
    in-out property <color> text-muted: #C8C8C8;
    in-out property <color> primary: #ffd60a;
    in-out property <color> primary-muted: #DBA800;
    in-out property <color> secondary: #008fba;
    in-out property <color> secondary-muted: #003566;
    in-out property <color> background: #000814;
    in-out property <color> background-light: #001730;
    in-out property <color> unchecked-color: #A8A8A8;
    in-out property <color> checked-color: #fffffa;
}
